<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TODO アプリ</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@700&family=Zen+Kaku+Gothic+New:wght@400;700&display=swap');
 body { font-family: 'Zen Kaku Gothic New', sans-serif; max-width: 600px; margin: 40px auto; padding: 32px; background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #311042 100%); color: #f8fafc; min-height: 100vh; }
 h1 { font-family: 'Montserrat', 'Zen Kaku Gothic New', sans-serif; text-align: center; background: linear-gradient(90deg, #38bdf8, #c084fc, #f472b6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .input-group { display: flex; gap: 10px; margin-bottom: 20px; }
   input[type="text"] { flex: 1; padding: 10px 14px; font-size: 16px; font-family: inherit; background: rgba(255, 255, 255, 0.1); color: #fff; border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 8px; outline: none; }
    button { padding: 10px 18px; font-size: 16px; font-weight: bold; font-family: inherit; cursor: pointer; background: linear-gradient(135deg, #06b6d4, #8b5cf6); color: white; border: none; border-radius: 8px; }
    ul { list-style: none; padding: 0; }
    li { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; margin-bottom: 10px; background: rgba(255, 255, 255, 0.08); border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.12); }
    .completed { text-decoration: line-through; color: #94a3b8; }
    .delete-btn { background: linear-gradient(135deg, #f43f5e, #ec4899); color: white; border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 14px; }
  </style>
  </style>
</head>
<body>
  <h1>TODO リスト</h1>

  <!-- タスク追加フォーム -->
  <div class="input-group">
    <input type="text" id="todoInput" placeholder="新しいタスクを入力..." />
    <button id="addBtn">追加</button>
  </div>

  <!-- TODO一覧リスト -->
  <ul id="todoList"></ul>

  <script src="/todo/todo.js"></script>
</body>
</html>